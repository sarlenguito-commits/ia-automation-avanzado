        "text": "={{ (() => { const filas = ($json.intermediateSteps || []).map(p => { try { const o = JSON.parse(p.observation); const r = Array.isArray(o) ? o[0] : o; return r && /^rec/.test(r.id || '') && r.createdTime ? r : null; } catch (e) { return null; } }).filter(Boolean); if (!filas.length) return 'Sin anotar: no era una visita, faltaban datos o Airtable rechazó la fila'; const linea = r => 'Visita anotada: ' + (r.fields.propiedad || 'sin propiedad') + ' - interés ' + (r.fields.interes || 'no_se') + ' - ' + (r.fields.proximo_paso || 'sin próximo paso') + ' (fila ' + r.id + ')'; return (filas.length > 1 ? 'Atención: se crearon ' + filas.length + ' filas\\n' : '') + filas.map(linea).join('\\n'); })() }}\nRespuesta del Anotador: {{ $json.output }}\nHerramienta: anotar_visita - {{ ($json.intermediateSteps || []).length }} intento(s)",
